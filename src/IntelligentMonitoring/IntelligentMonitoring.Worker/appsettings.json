{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Loki": {
    "BaseUrl": "http://localhost:3100/"
  },
  "ConnectionStrings": {
    "MonitoringDb": "Server=localhost\\SQLEXPRESS;Database=IntelligentMonitoringDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "FailureTopic": "integration.failures",
    "ConsumerGroup": "intelligent-monitoring-worker"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:3b",
    "TimeoutSeconds": 120
  },
  "Investigation": {
    "LookbackHours": 24,
    "PostFailureBufferMinutes": 15,
    "PollingIntervalSeconds": 10,
    "BatchSize": 10,
    "MaxRetries": 5
  }

}
