{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "MonitoringDb": "Server=localhost\\SQLEXPRESS;Database=IntelligentMonitoringDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Slack": {
    "ApiBaseUrl": "https://slack.com/api/"
  },
  "Notifications": {
    "Enabled": true,
    "PollingIntervalSeconds": 10,
    "BatchSize": 10,
    "ProcessingLeaseMinutes": 5,
    "MaxRetries": 5,
    "RetryDelaysSeconds": [ 30, 60, 120, 300, 600 ],
    "Channels": [
      {
        "Channel": "Slack",
        "Enabled": true,
        "Destinations": [
          "integration-alerts"
        ]
      },
      {
        "Channel": "Email",
        "Enabled": false,
        "Destinations": []
      },
      {
        "Channel": "MicrosoftTeams",
        "Enabled": false,
        "Destinations": []
      }
    ]
  }
}
